{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "dinosaur-rpg",
  "main": "./index.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY", "GAME_TOKEN"]
  },
  "ratelimits": [
    {
      "name": "GM_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
